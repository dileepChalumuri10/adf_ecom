			{
				"name": "Reload DimProduct",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Reload DimCustomer",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_db",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "DELETE FROM DimProduct;\n\nINSERT INTO DimProduct (StockCode, Description)\nSELECT StockCode, MIN(Description)\nFROM Staging_Sales\nGROUP BY StockCode;",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
